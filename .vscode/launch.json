{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Host C/C++ (Taylor)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/dev-debug/red-patterns",
      "args": [
        "--use-taylor",
        "--T=0.01",
        "--DT=0.005",
        "--NO=1",
        "--gradient=linear",
        "--NU=-2.832638e-30",
        "--MU=-4.468455e-37",
        "--phi-file=${workspaceFolder}/data/phi_const.h5",
        "--out-dir=${workspaceFolder}/data/debug-host"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Prepare host debug run"
    },
    {
      "name": "Debug Host C/C++ (Convolution)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/dev-debug/red-patterns",
      "args": [
        "--use-convolution",
        "--T=0.01",
        "--DT=0.005",
        "--NO=1",
        "--gradient=linear",
        "--phi-file=${workspaceFolder}/data/phi_const.h5",
        "--kernel-file=${workspaceFolder}/data/kernel.h5",
        "--out-dir=${workspaceFolder}/data/debug-host"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Prepare host debug run"
    }
  ]
}
