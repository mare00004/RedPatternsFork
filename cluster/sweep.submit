# ---------- MACROS ----------
# Override on submission with:
#   condor_submit VAR1=VALUE1 VAR2=VALUE2 ... sweep.submit

COMMIT_HASH = $(COMMIT_HASH:1935885)
RUN_DIR = $(RUN_DIR:$(SUBMIT_FILE_DIR))
RUNS_JSONL = $(RUNS_JSONL:$(RUN_DIR)/runs.jsonl)
RUN_IDS_FILE = $(RUN_IDS_FILE:$(RUN_DIR)/run_ids.txt)
LAUNCH_SH = $(LAUNCH_SH:$(SUBMIT_FILE_DIR)/launch.sh)
RUN_TAG = $(RUN_TAG:sweep)


# ---------- DOCKER ----------

universe = docker
docker_image = mare00004/cuda-hdf5-dev:$(COMMIT_HASH)
docker_pull_policy = always


# ---------- HARDWARE ----------

request_gpus = 1
request_cpus = 16
request_memory = 16 GB
request_disk = 16 GB

requirements = (UidDomain == "cs.uni-saarland.de") && (GPUs_Capability >= 7.0) && (GPUs_GlobalMemoryMb >= 16000)
+WantGPUHomeMounted = true
+WantScratchMounted = true


# ---------- JOBS ----------

max_idle = 100

should_transfer_files = IF_NEEDED
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True

transfer_input_files = $(LAUNCH_SH),$(RUNS_JSONL)
transfer_executable = True
transfer_output_files = run.h5,command.txt,run_spec.json
transfer_output_remaps = "run.h5 = results/$(run_id)/run.h5; command.txt = results/$(run_id)/command.txt; run_spec.json = results/$(run_id)/run_spec.json"

initialdir = $(RUN_DIR)
batch_name = $(RUN_TAG)

executable = $(LAUNCH_SH)
arguments = $(run_id)

log = logs/$(run_id).log
output = logs/$(run_id).out
error = logs/$(run_id).err

queue run_id from $(RUN_IDS_FILE)
